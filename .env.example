# Client: api for real persistence; demo ONLY for isolated UI checks.
VITE_RESULTS_MODE=api
API_HOST=127.0.0.1
API_PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=olympiad
MYSQL_USER=olympiad
MYSQL_PASSWORD=replace-with-a-secret
# Optional CA file for a remote MySQL server. Certificate verification is enabled.
MYSQL_SSL_CA=
# Private organiser-supplied file, OUTSIDE the public web root; never commit it.
SCORING_SOURCE_PATH=/secure/olympiad/Code.gs
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx56jow7xKI0Ugoh8wx29ojRUu68AHixLi58T7kRDOfWwT4Fdz4lO_3LyPCnDfmEQaLBQ/exec
SYNC_INTERVAL_MS=15000
SYNC_TIMEOUT_MS=45000
# Only for a loopback mock in tests, never production:
ALLOW_LOCAL_SYNC=false
